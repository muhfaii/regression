{
	"name": "infera",
	"main": "worker/src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "infera.byopre.com",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	// Backend runs on Render (Cloudflare Containers requires Workers Paid,
	// see the deploy history for why we moved off it). The Worker proxies
	// /api/* here instead of using a Container binding.
	"vars": {
		"BACKEND_URL": "https://infera-backend-xrix.onrender.com"
	},
	// v1 registered the InferaBackend Durable Object class from the earlier
	// Container-based approach; v2 removes it now that the backend runs on
	// Render instead. Required so Cloudflare doesn't reject deploys for no
	// longer exporting a class it thinks still has live instances.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["InferaBackend"] },
		{ "tag": "v2", "deleted_classes": ["InferaBackend"] }
	],
	// Only used by `wrangler d1 migrations` tooling — the FastAPI app itself
	// reaches D1 over its HTTP REST API (backend/services/d1.py), since it
	// doesn't run inside the Workers runtime.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "infera-db",
			"database_id": "2b88f2d9-d2b6-4267-8e39-68718f50608b"
		}
	]
}
